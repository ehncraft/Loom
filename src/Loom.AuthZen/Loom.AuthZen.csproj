<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Loom.Core\Loom.Core.csproj" />
    <ProjectReference Include="..\Loom.Evaluator\Loom.Evaluator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="SecurityCodeScan.VS2019" Version="5.6.7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Loom.AuthZen</PackageId>
    <Description>AuthZEN Authorization API 1.0-compatible HTTP endpoint (MapAuthZenEndpoints) in front of a LoomEvaluator.</Description>
  </PropertyGroup>

</Project>
