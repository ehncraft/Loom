<Project Sdk="Microsoft.NET.Sdk">

  <ItemGroup>
    <ProjectReference Include="..\Loom.Core\Loom.Core.csproj" />
    <ProjectReference Include="..\Loom.Schema\Loom.Schema.csproj" />
    <ProjectReference Include="..\Loom.Relationships\Loom.Relationships.csproj" />
    <ProjectReference Include="..\Loom.Caveats\Loom.Caveats.csproj" />
    <ProjectReference Include="..\Loom.Evaluator\Loom.Evaluator.csproj" />
  </ItemGroup>

  <ItemGroup>
    <FrameworkReference Include="Microsoft.AspNetCore.App" />
    <PackageReference Include="SecurityCodeScan.VS2019" Version="5.6.7">
      <IncludeAssets>runtime; build; native; contentfiles; analyzers; buildtransitive</IncludeAssets>
      <PrivateAssets>all</PrivateAssets>
    </PackageReference>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net11.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <PackageId>Loom.AspNetCore</PackageId>
    <Description>ASP.NET Core DI integration for Loom -- services.AddLoom(...) registration and an IAuthorizationHandler for declarative policy-based checks.</Description>
  </PropertyGroup>

</Project>
